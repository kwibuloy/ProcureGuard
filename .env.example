# Copy this file to .env and adjust. .env is never committed.

# PostgreSQL (local Docker container)
POSTGRES_USER=procureguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=procureguard
# Change this if another PostgreSQL already uses 5432 on your machine.
POSTGRES_PORT=5432

# Hosted PostgreSQL for the Vercel deployment. Set it in the Vercel project
# settings, not here. When set, the API uses it instead of the POSTGRES_* values.
# DATABASE_URL=postgres://user:password@host:5432/procureguard?sslmode=require

# Unpooled address of the hosted database, used only to copy the local Docker
# database into it. Leave unset unless you are refreshing the hosted copy.
# NEON_DATABASE_URL=postgres://user:password@host/procureguard?sslmode=require

# Express API (the dashboard's dev server forwards /api to this port)
API_PORT=3001
